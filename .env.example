# 方案模式：free / sponsor / pro
PLAN=free

# Neon 資料庫連線字串
DATABASE_URL=

# FinMind
FINMIND_TOKEN=

# LINE Messaging API（只推給自己）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_OWNER_USER_ID=

# AI 判讀：ollama / claude / rules（只用關鍵字）
# AI 連不上或未設定時自動改用關鍵字判讀
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
ANTHROPIC_API_KEY=
# 選用，預設 claude-opus-5-5
ANTHROPIC_MODEL=

# 個人網站
SITE_PASSWORD=
# 網站網址（LINE 報告附連結用，選用）
SITE_URL=
SESSION_SECRET=
# MCP 接口權杖（選用，至少 32 字元，openssl rand -hex 32）；未設定時接口關閉
MCP_TOKEN=
